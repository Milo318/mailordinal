# Server-side only. Never prefix this key with NEXT_PUBLIC_.
TYPESAFE_API_KEY=

# Pin a version after calibrating thresholds in production.
TYPESAFE_MODEL=jev-latest

# Set to "demo" to force transparent local fixture decisions.
# Set to "jev" to require the live provider and fail if the key is missing.
MAILORDINAL_PROVIDER=demo

# Public live deployments should sit behind authentication.
MAILORDINAL_RATE_LIMIT_PER_MINUTE=20

# Public canonical URL used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
